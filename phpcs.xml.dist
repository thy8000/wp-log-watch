<?xml version="1.0"?>
<ruleset name="WP Log Watch">
    <description>
        Coding standards for the WP Log Watch plugin.

        Security-sensitive rules (escaping, sanitization, prepared SQL, nonces,
        i18n and strict comparisons) are enforced. The naming and doc-comment
        rules from the WordPress standard are excluded because this plugin uses
        PSR-4 namespaces and camelCase method names (see the spec), which
        conflict with the WordPress snake_case convention.
    </description>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <file>src</file>
    <file>wp-log-watch.php</file>
    <file>uninstall.php</file>

    <rule ref="WordPress">
        <!-- PSR-4 file names and camelCase methods/variables. -->
        <exclude name="WordPress.Files.FileName"/>
        <exclude name="WordPress.NamingConventions.PrefixAllGlobals"/>
        <exclude name="WordPress.NamingConventions.ValidFunctionName"/>
        <exclude name="WordPress.NamingConventions.ValidVariableName"/>

        <!-- Yoda conditions are style, not security. -->
        <exclude name="WordPress.PHP.YodaConditions"/>

        <!-- The repository is the intentional database adapter (custom table). -->
        <exclude name="WordPress.DB.DirectDatabaseQuery"/>

        <!-- Read-only GET filters do not require a nonce. -->
        <exclude name="WordPress.Security.NonceVerification.Recommended"/>

        <!-- Domain exceptions carry developer-facing messages, not HTML output. -->
        <exclude name="WordPress.Security.EscapeOutput.ExceptionNotEscaped"/>

        <!-- Doc-comment boilerplate is noise for a modern PSR-4 codebase. -->
        <exclude name="Squiz.Commenting.FileComment"/>
        <exclude name="Squiz.Commenting.FunctionComment"/>
        <exclude name="Squiz.Commenting.FunctionCommentThrowTag"/>
        <exclude name="Squiz.Commenting.VariableComment"/>
        <exclude name="Squiz.Commenting.ClassComment"/>
        <exclude name="Generic.Commenting.DocComment"/>
        <exclude name="Generic.CodeAnalysis.UnusedFunctionParameter"/>
    </rule>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="wp-log-watch"/>
            </property>
        </properties>
    </rule>

    <config name="minimum_supported_wp_version" value="6.0"/>

    <rule ref="Universal.Operators.StrictComparisons"/>
</ruleset>
